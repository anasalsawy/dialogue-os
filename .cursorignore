# Files the Cursor agent must never read, @-mention, or index.
# .gitignore syntax. Install to <DIALOGUE_OS_ROOT>/.cursorignore
#
# Scope note from Cursor docs: .cursorignore blocks Agent/Tab/Inline-Edit code
# access and @ mentions, but it does NOT block terminal or MCP tools. The
# Read(...)/Shell(...) deny rules in .cursor/cli.json cover that gap.

# --- Environment files ---
.env
.env.*
**/.env
**/.env.*
!.env.example

# --- Private keys and certificates ---
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
**/.ssh/**

# --- Credentials and tokens ---
*credentials*
*credential*
*_secret*
*secrets*
.netrc
.git-credentials
.npmrc
.pypirc
auth.json
token.json
tokens.json
service-account*.json

# --- SQLite secret material (Hermes sessions, Cursor session IDs, bot metadata) ---
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal
data/*.sqlite3-journal
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-shm
*.db-wal

# --- Runtime state that can contain message contents or secrets ---
data/canonical/
data/logs/
data/bridge.lock
*.log

# --- Agent permission config (operator-owned; the agent must not self-grant) ---
.cursor/
