# Dialogue-OS / YTA environment template — names only, never real secrets.
# Copy to .env and fill values. Restrict .env to mode 600 under the service user.

# Fixed absolute workspace (do not change once sessions exist)
DIALOGUE_OS_ROOT=/home/azureuser/dialogue-os

# Operator / channel
TELEGRAM_OWNER_ID=
TELEGRAM_CANONICAL_CHANNEL_ID=

# Bot tokens (one consumer per token; long-polling OR webhook, never both)
TELEGRAM_CHIEF_BOT_TOKEN=
TELEGRAM_BUILDER_BOT_TOKEN=
TELEGRAM_RESEARCH_BOT_TOKEN=
TELEGRAM_OPERATIONS_BOT_TOKEN=
TELEGRAM_GROWTH_BOT_TOKEN=
TELEGRAM_CUSTOMER_RELATIONS_BOT_TOKEN=
TELEGRAM_STAGEHAND_BOT_TOKEN=
TELEGRAM_WATCHER_ALPHA_BOT_TOKEN=
TELEGRAM_WATCHER_BETA_BOT_TOKEN=

# Cursor CLI control plane
CURSOR_CLI_BIN=agent
CURSOR_MODEL=
CURSOR_TIMEOUT_SECONDS=1800
CURSOR_CONTROL_SESSION_KEY=primary
# Unrestricted Agent: auto-detect --force vs --yolo from `agent --help`.
# Optional override: CURSOR_FORCE_FLAG=--force
# Never set both. Do not use --sandbox. approvalMode=unrestricted is applied
# to ~/.cursor/cli-config.json by the bridge / validate_config.
# Optional: CURSOR_API_KEY=  (prefer `agent login` on the service account)
# Operational Cursor sessions always run in default Agent mode (no --mode).

# Hermes OpenAI-compatible provider (required for non-Chief agents)
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=
HERMES_MAX_OUTPUT_TOKENS=4096
HERMES_TIMEOUT_SECONDS=120

# Browser tooling (optional; Stagehand/Browserbase is a tool, not a chat backend)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
STAGEHAND_ENABLED=false

# Active-mission supervision. The supervisor inspects missions whose
# next_check_at (stored in SQLite) has passed, so supervision survives
# restarts. SUPERVISION_TICK_SECONDS=0 disables supervision entirely.
SUPERVISION_TICK_SECONDS=15
MISSION_ACK_TIMEOUT_SECONDS=300
MISSION_HEARTBEAT_TIMEOUT_SECONDS=600
MISSION_OWNER_UPDATE_SECONDS=1800
MISSION_MAX_UNSUPPORTED_CLAIMS=2
MISSION_SUPERVISION_WATCHER=watcher_alpha

# Runtime
DATABASE_PATH=/home/azureuser/dialogue-os/data/dialogue_os.sqlite3
CANONICAL_LOG_PATH=/home/azureuser/dialogue-os/data/canonical/events.jsonl
HEALTH_BIND=127.0.0.1
HEALTH_PORT=8787
# Generate a long random value. This bearer token is shared only with the
# private War Room deployment and must never be committed or logged.
WAR_ROOM_API_TOKEN=
WAR_ROOM_ALLOWED_ORIGINS=https://yta-war-room-live.masryalsawy.chatgpt.site
LOG_LEVEL=INFO
SERVICE_USER=azureuser
BOT_TO_BOT_CHATTER=false
AZURE_LLM_DISABLED=true

# Encrypted state backup (optional; never commit real keys)
# age public recipient, e.g. age1...
BACKUP_AGE_RECIPIENT=
# Destination: file:///path, /path, or s3://bucket/prefix
BACKUP_DESTINATION=
# Private age identity path for restore verification only (never commit the key file)
# BACKUP_AGE_IDENTITY=
