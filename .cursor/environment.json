{
  "name": "Dialogue OS",
  "install": "bash .cursor/install.sh",
  "repositoryDependencies": [
    "github.com/anasalsawy/dialogue-os-runtime",
    "github.com/anasalsawy/yta-assistant-travel-memory",
    "github.com/anasalsawy/your-travel-agent-ccb6b77f"
  ],
  "terminals": [
    {
      "name": "api",
      "command": "cd ../yta-assistant-travel-memory && . .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000",
      "description": "YTA-ASSISTANT FastAPI backend on http://localhost:8000 (health, memory, flights/hotels/cars endpoints)."
    },
    {
      "name": "web",
      "command": "cd ../your-travel-agent-ccb6b77f && npm run dev",
      "description": "Your Travel Agent Vite/React dev server on http://localhost:8080."
    }
  ],
  "ports": [
    { "name": "web", "port": 8080 },
    { "name": "api", "port": 8000 }
  ]
}
